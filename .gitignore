# =============================================================================
# IP PROTECTION: DO NOT REMOVE OR LOOSEN THESE RULES WITHOUT REVIEW
# =============================================================================
# This repository must never contain game data, extracted assets, executables
# or any material owned by Sony Interactive Entertainment / genDESIGN /
# Japan Studio. The rules below ignore every common PS4 dump and extracted
# format. If a real source file collides with a pattern, rename the file
# rather than weakening the pattern.
# =============================================================================

# --- Packages, executables, modules, metadata from the user's own copy ---
*.pkg
*.bin
*.self
*.elf
*.prx
*.sprx
*.sfo
*.sfx
*.rco
*.trp
*.at9
*.pfs
*.dat
*.gp4
baserom/
eboot*
param.sfo
sce_sys/
sce_module/
CUSA*
EP9000-*
UP9000-*
JP9000-*

# --- Build outputs that may embed data derived from the executable ---
build/
*.o
*.a
*.obj
*.map
*.ll
*.bc

# --- Extracted assets (populated at build time from the user's own copy) ---
assets/

# --- Analysis databases derived from the original executable ---
*.gpr
*.rep/
*.i64
*.idb
*.bndb

# --- Toolchain / venv / editor noise ---
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.mypy_cache/
.pytest_cache/
.idea/
.vscode/
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db

# --- Local config overrides ---
.env
.env.local
config/local.*

# --- Local toolchain (tools/setup.sh: compilers, extractors, Ghidra) ---
tools/cc/
tools/ext/
tools/ghidra/

# --- Agent guidance / local-only ---
# CLAUDE.md is auto-loaded by Claude Code and is the agent's local preamble;
# it stays out of the public repo.
CLAUDE.md
.claude/

# --- Ninja build files (tools/gen_ninja.py writes build.ninja) ---
build.ninja
.ninja_log
.ninja_deps

# --- Working notes kept on the maintainer's machine ---
docs/NOTES.md
docs/COOKBOOK.md

# Assembled GitHub Pages site (regenerable: .github/scripts/build_pages_site.sh).
_site/
