+// Whether a pointer based on Object is passed, by a call that may reach I, as
+// an argument the call may write through: any call other than an intrinsic
+// whose argument is not read only.
+static bool passedToWriterBefore(const Value *Object, const Instruction *I,
+                                 const DominatorTree *DT) {
+  SmallVector<const Value *, 8> Worklist;
+  SmallPtrSet<const Value *, 8> Visited;
+  Worklist.push_back(Object);
+  Visited.insert(Object);
+  while (!Worklist.empty()) {
+    const Value *V = Worklist.pop_back_val();
+    for (const Use &U : V->uses()) {
+      const Instruction *User = dyn_cast<Instruction>(U.getUser());
+      if (!User || User == I)
+        continue;
+      if (isa<BitCastInst>(User) || isa<GetElementPtrInst>(User) ||
+          isa<PHINode>(User) || isa<SelectInst>(User) ||
+          isa<AddrSpaceCastInst>(User)) {
+        if (Visited.insert(User).second)
+          Worklist.push_back(User);
+        continue;
+      }
+      ImmutableCallSite UCS(User);
+      if (!UCS.getInstruction() || isa<IntrinsicInst>(User))
+        continue;
+      if (&U < UCS.arg_begin() || &U >= UCS.arg_end())
+        continue;
+      unsigned ArgNo = UCS.getArgumentNo(&U);
+      if (UCS.onlyReadsMemory() || UCS.onlyReadsMemory(ArgNo))
+        continue;
+      if (isPotentiallyReachable(User, I, DT))
+        return true;
+    }
+  }
+  return false;
+}
